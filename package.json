{
    "name": "backend-part-2",
    "version": "1.0.0",
    "description": "Production-grade Express.js backend with TypeScript and MongoDB",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
        "build": "tsc",
        "start": "node --import ./dist/instrumentation.js dist/server.js",
        "start:prod": "NODE_ENV=production node --import ./dist/instrumentation.js dist/server.js",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "express",
        "typescript",
        "mongodb",
        "mongoose",
        "backend"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@bull-board/api": "^6.13.0",
        "@bull-board/express": "^6.13.0",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.65.0",
        "@opentelemetry/exporter-prometheus": "^0.206.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.206.0",
        "@opentelemetry/instrumentation-express": "^0.55.0",
        "@opentelemetry/instrumentation-http": "^0.206.0",
        "@opentelemetry/instrumentation-ioredis": "^0.54.0",
        "@opentelemetry/instrumentation-kafkajs": "^0.16.0",
        "@opentelemetry/instrumentation-mongodb": "^0.59.0",
        "@opentelemetry/resources": "^2.1.0",
        "@opentelemetry/sdk-metrics": "^2.1.0",
        "@opentelemetry/sdk-node": "^0.206.0",
        "@opentelemetry/sdk-trace-node": "^2.1.0",
        "@opentelemetry/semantic-conventions": "^1.37.0",
        "bullmq": "^5.61.0",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "http-status": "^1.7.3",
        "joi": "^17.11.0",
        "kafkajs": "^2.2.4",
        "mongoose": "^8.0.3",
        "nodemailer": "^7.0.9",
        "prom-client": "^15.1.3",
        "redis": "^4.7.0",
        "resend": "^6.1.2",
        "uuid": "^13.0.0",
        "winston": "^3.11.0",
        "winston-loki": "^6.1.3"
    },
    "devDependencies": {
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/nodemailer": "^7.0.2",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^6.16.0",
        "@typescript-eslint/parser": "^6.16.0",
        "axios": "^1.12.2",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.2",
        "prettier": "^3.1.1",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}
